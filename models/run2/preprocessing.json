  ],
  "tfidf": {
    "ngram_range": [
      1,
      2
    ],
    "min_df": 5,
    "max_features": 100000,
    "sublinear_tf": true,
    "token_pattern": "(?u)\\b\\w\\w+\\b",
    "dtype": "float32"
  },
  "classes": [
    "Low (1-3)",
    "Middle (4-7)",
    "High (8-10)"
  ],
  "objective1_served": "DistilBERT (compressed)",
  "objective1_fallback": "TF-IDF + LR",
  "objective1_onnx": {
    "file": "distilbert_onnx/model_int8.onnx",
    "tokenizer": "distilbert_onnx",
    "max_length": 256,
    "inputs": [
      "input_ids",
      "attention_mask"
    ],
    "output": "logits (apply softmax)"
  },
  "objective1_fallback_cutoffs": null,
  "objective2_served": "Structured only",
  "objective2_inputs": [
    "rating",
    "review_words",
    "condition",
    "medication"
  ],
  "objective2_helpful_definition": "top 25% of helpful votes among reviews posted in the same month",
  "objective2_test_score_quantiles": {
    "0.5": 0.09847578258543321,
    "0.75": 0.36307496843264286,
    "0.9": 0.676669133709172
  }
